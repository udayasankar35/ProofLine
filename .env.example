# Copy to .env.local for local work. On Vercel, add these under Project > Settings > Environment Variables.
# NEVER commit real keys.

# Supabase (Project Settings > API). Leave both empty to run with an in-memory demo store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI claim check (optional). Without a key, ProofLine runs in rules-only mode.
AI_PROVIDER=gemini        # gemini | openai | anthropic
AI_API_KEY=
AI_MODEL=                 # optional, e.g. gemini-3.8-flash
AI_BASE_URL=              # optional, for an OpenAI-compatible or proxied endpoint
AI_SESSION_CAP=15         # max AI checks per browser session
AI_DAILY_CAP=300          # max AI checks per day across all visitors
